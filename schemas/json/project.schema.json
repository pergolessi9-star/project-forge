{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-forge/project.schema.json",
  "type": "object",
  "required": ["projectCode", "name", "slug", "status", "currentStage"],
  "properties": {
    "projectCode": {"type": "string", "maxLength": 50},
    "name": {"type": "string", "minLength": 1, "maxLength": 255},
    "slug": {"type": "string", "maxLength": 255},
    "description": {"type": "string"},
    "status": {
      "enum": ["IDEA","DISCOVERY","EVIDENCE_REVIEW","CONCEPT","MVP","VALIDATION","SPECIFICATION","ENGINEERING","ARCHIVED","REJECTED"]
    },
    "currentStage": {
      "enum": ["INTAKE","PROBLEM","MARKET","TECHNOLOGY","REGULATION","EVIDENCE","CONCEPT","MVP","VALIDATION","SPECIFICATION"]
    }
  }
}